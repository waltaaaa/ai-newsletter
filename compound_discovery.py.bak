"""
compound_discovery.py — Async Gemini grounded search engine for compound queries.

Sends 759 compound queries per week through Gemini 2.5 Flash with Google Search
grounding. Each response returns structured JSON with 0-N projects.
Runs in ~3 minutes with 15x parallelism.

Also provides a synchronous wrapper run_compound_search() that matches the
interface expected by update_dashboard.py (returns list[dict] compatible with
the existing gemini_search.py output format).
"""

import asyncio
import aiohttp
import json
import re
import os
import time
import logging

from compound_queries import get_weekly_queries

logger = logging.getLogger(__name__)

GEMINI_API_KEY = os.environ.get("GEMINI_API_KEY", "")
GEMINI_MODEL = os.environ.get("GEMINI_MODEL", "gemini-2.5-flash")
GEMINI_ENDPOINT = f"https://generativelanguage.googleapis.com/v1beta/models/{GEMINI_MODEL}:generateContent"
MAX_CONCURRENT = 15
RETRY_DELAY = 60

EXTRACTION_SYSTEM_PROMPT = """You are a Canadian capital projects research assistant. Find and list major capital projects based on the user's query.

Return a JSON object with this structure:
{
  "projects": [
    {
      "name": "Project name",
      "proponent": "Company or organization",
      "location": {
        "city": "City name",
        "province": "Two-letter code (ON, QC, AB, BC, SK, MB, NS, NB, NL, PE, YT, NT, NU)",
        "cma": "Census Metropolitan Area name or null"
      },
      "value_millions": 650,
      "currency": "CAD",
      "status": "proposed | approved | under_construction | completed | delayed | cancelled | on_hold",
      "project_type": "greenfield | redevelopment | adaptive_reuse | major_renovation | expansion | retrofit | restoration | remediation | conversion | modernization | decommission_replace",
      "sector": "Sector description",
      "naics_2digit": "Best-fit 2-digit NAICS code",
      "description": "One-sentence project description",
      "source_url": "URL of the source article or announcement",
      "source_name": "Publication or organization name",
      "date_reported": "YYYY-MM-DD",
      "confidence_notes": "Any caveats (unconfirmed value, rumoured, etc.)"
    }
  ]
}

RULES:
1. Only include projects with VERIFIED information from search results. Never fabricate.
2. If no matching projects found, return {"projects": []}.
3. Include BOTH greenfield (new builds) AND brownfield (redevelopments, renovations, expansions, conversions, adaptive reuse, modernizations).
4. Always include source_url with a real, complete URL starting with https://. If you cannot provide a real source URL, DO NOT include that project.
5. Values in millions CAD. Note approximations in confidence_notes.
6. For project_type: greenfield, redevelopment, adaptive_reuse, major_renovation, expansion, retrofit, restoration, remediation, conversion, modernization, decommission_replace.
7. Return ONLY the JSON object. No markdown, no preamble.
8. Every project MUST have a name and source_url at minimum.

CRITICAL URL REQUIREMENTS:
- Every project MUST have a source_url field with a real, complete URL starting with https://
- The URL must be from your search results - do not fabricate or guess URLs
- If you cannot provide a real source URL for a project, DO NOT include that project
- Government press release URLs (canada.ca, .gc.ca, provincial .ca sites) are the most valuable
- News article URLs (cbc.ca, globalnews.ca, etc.) are the next most valuable
- A project without a source URL is USELESS - we need it for independent verification
- Include the full URL path, not just the domain"""


# ============================================================================
# STATUS NORMALIZATION — map compound discovery statuses to pipeline statuses
# ============================================================================

_STATUS_MAP = {
    "proposed": "Proposed",
    "approved": "Approved",
    "under_construction": "Under Construction",
    "completed": "Completed",
    "delayed": "Paused",
    "cancelled": "Cancelled",
    "on_hold": "Paused",
}


def _normalize_status(raw):
    return _STATUS_MAP.get(raw, raw.title() if raw else "Proposed")


def _format_value(val_millions):
    """Convert numeric millions to display string like 'C$650M'."""
    if val_millions is None:
        return "Not disclosed"
    try:
        v = float(val_millions)
        if v >= 1000:
            return f"C${v/1000:.1f}B"
        return f"C${v:.0f}M"
    except (TypeError, ValueError):
        return "Not disclosed"


# ============================================================================
# ASYNC DISCOVERY ENGINE
# ============================================================================

async def run_compound_discovery():
    """Run all compound queries async. Returns list of project dicts."""
    queries = get_weekly_queries()
    logger.info(f"Starting compound discovery: {len(queries)} queries")
    print(f"\n[COMPOUND] Starting async discovery: {len(queries)} queries, "
          f"{MAX_CONCURRENT}x parallelism...")

    semaphore = asyncio.Semaphore(MAX_CONCURRENT)

    async with aiohttp.ClientSession() as session:
        tasks = [_query_gemini(session, semaphore, q) for q in queries]
        results = await asyncio.gather(*tasks, return_exceptions=True)

    all_projects = []
    errors = 0
    empty = 0

    for i, result in enumerate(results):
        if isinstance(result, Exception):
            errors += 1
            if errors <= 5:
                logger.warning(f"Query {i} ({queries[i].get('sector')}/{queries[i].get('geo_tier')}) failed: {result}")
            continue

        projects = result.get("projects", [])
        if not projects:
            empty += 1
            continue

        for project in projects:
            project["_source_query_sector"] = queries[i].get("sector")
            project["_source_query_geo_tier"] = queries[i].get("geo_tier")
            project["_source_query_language"] = queries[i].get("language")
            project["_source_query_province"] = queries[i].get("province")
            all_projects.append(project)

        if (i + 1) % 50 == 0:
            print(f"  [COMPOUND] {i+1}/{len(queries)} queries done, "
                  f"{len(all_projects)} projects so far")

    print(f"  [COMPOUND] Complete: {len(all_projects)} project mentions "
          f"from {len(queries)} queries ({errors} errors, {empty} empty)")

    return all_projects


async def _query_gemini(session, semaphore, query_obj, attempt=0):
    """Send one compound query to Gemini grounded search."""
    from gemini_engine import query_one
    result = await query_one(session, semaphore, query_obj,
                             EXTRACTION_SYSTEM_PROMPT, attempt)
    if result.get("error"):
        raise Exception(result["error"])
    # Reconstruct the raw API response shape that _parse_response expects
    return _parse_response_from_engine(result, query_obj)


def _parse_response_from_engine(engine_result, query_obj):
    """Adapt gemini_engine result to the same output as _parse_response."""
    import json as _json
    text = engine_result.get("text", "")
    grounding_urls_raw = engine_result.get("grounding_urls", [])

    try:
        # Strip markdown fences
        text = re.sub(r'```json\s*', '', text)
        text = re.sub(r'```\s*', '', text)
        text = text.strip()
        if not text:
            return {"projects": []}

        data = _json.loads(text)
        if isinstance(data, list):
            data = {"projects": data}

        # Build grounding URL structures matching _parse_response format
        grounding_url_dicts = []
        grounding_uri_set = set()
        for g in grounding_urls_raw:
            url = g["url"] if isinstance(g, dict) else g
            title = g.get("title", "") if isinstance(g, dict) else ""
            grounding_url_dicts.append({
                "url": url, "name": title, "source_type": "gemini_grounding",
            })
            grounding_uri_set.add(url)

        for project in data.get("projects", []):
            project.setdefault("_evidence", [])
            extracted_url = project.get("source_url", "")
            if extracted_url and extracted_url.startswith("http"):
                project["_evidence"].append({
                    "url": extracted_url,
                    "name": project.get("source_name", ""),
                    "date": project.get("date_reported", ""),
                    "source_type": "gemini_extracted",
                })
            existing_urls = {e["url"] for e in project["_evidence"]}
            for g_url in grounding_url_dicts:
                if g_url["url"] not in existing_urls:
                    project["_evidence"].append({
                        "url": g_url["url"], "name": g_url["name"],
                        "date": "", "source_type": "gemini_grounding",
                    })
                    existing_urls.add(g_url["url"])
            if not project.get("source_url") and grounding_url_dicts:
                project["source_url"] = grounding_url_dicts[0]["url"]
                project["source_name"] = project.get("source_name") or grounding_url_dicts[0]["name"]
            if not project["_evidence"]:
                project["_needs_url"] = True
            src = project.get("source_url", "")
            project["_grounded"] = src in grounding_uri_set if src else False

        return data
    except (_json.JSONDecodeError, KeyError, IndexError) as e:
        logger.warning(f"Parse error [{query_obj.get('sector')}]: {e}")
        return {"projects": []}


def _parse_response(api_response, query_obj):
    """Parse Gemini response with FULL grounding URL extraction."""
    try:
        candidates = api_response.get("candidates", [])
        if not candidates:
            return {"projects": []}

        parts = candidates[0].get("content", {}).get("parts", [])
        text = " ".join(p.get("text", "") for p in parts)

        # Strip markdown fences
        text = re.sub(r'```json\s*', '', text)
        text = re.sub(r'```\s*', '', text)
        text = text.strip()

        if not text:
            return {"projects": []}

        data = json.loads(text)

        # Handle array responses (some queries return [] instead of {"projects":[]})
        if isinstance(data, list):
            data = {"projects": data}

        # -- CRITICAL: Extract ALL grounding URLs --
        grounding = candidates[0].get("groundingMetadata", {})
        grounding_chunks = grounding.get("groundingChunks", [])

        grounding_urls = []
        grounding_uri_set = set()
        for chunk in grounding_chunks:
            web = chunk.get("web", {})
            if web.get("uri"):
                grounding_urls.append({
                    "url": web["uri"],
                    "name": web.get("title", ""),
                    "source_type": "gemini_grounding",
                })
                grounding_uri_set.add(web["uri"])

        # -- Enrich each project with grounding URLs --
        for project in data.get("projects", []):
            project.setdefault("_evidence", [])

            # 1. Add the project's own source_url (from Gemini's JSON extraction)
            extracted_url = project.get("source_url", "")
            if extracted_url and extracted_url.startswith("http"):
                project["_evidence"].append({
                    "url": extracted_url,
                    "name": project.get("source_name", ""),
                    "date": project.get("date_reported", ""),
                    "source_type": "gemini_extracted",
                })

            # 2. Add ALL grounding URLs as additional evidence
            existing_urls = {e["url"] for e in project["_evidence"]}
            for g_url in grounding_urls:
                if g_url["url"] not in existing_urls:
                    project["_evidence"].append({
                        "url": g_url["url"],
                        "name": g_url["name"],
                        "date": "",
                        "source_type": "gemini_grounding",
                    })
                    existing_urls.add(g_url["url"])

            # If still no source_url, fill from first grounding URL
            if not project.get("source_url") and grounding_urls:
                project["source_url"] = grounding_urls[0]["url"]
                project["source_name"] = project.get("source_name") or grounding_urls[0]["name"]

            # 3. Flag projects with NO URLs
            if not project["_evidence"]:
                project["_needs_url"] = True
                logger.warning(
                    f"Project '{project.get('name')}' has NO source URLs -- "
                    f"will be held for manual review"
                )

            # Tag confidence based on grounding
            src = project.get("source_url", "")
            project["_grounded"] = src in grounding_uri_set if src else False

        return data

    except (json.JSONDecodeError, KeyError, IndexError) as e:
        logger.warning(f"Parse error [{query_obj.get('sector')}]: {e}")
        return {"projects": []}


# ============================================================================
# SYNCHRONOUS WRAPPER — compatible with existing pipeline interface
# ============================================================================

def run_compound_search(deep_sweep=False, watchlist=None, gemini_client=None):
    """
    Synchronous wrapper matching run_gemini_search() interface.

    Args:
        deep_sweep: Ignored (compound queries already cover deep sweep scope).
        watchlist: Ignored (compound queries cover all sectors/geographies).
        gemini_client: Ignored (uses aiohttp directly for async parallelism).

    Returns:
        List of project dicts in the same format as gemini_search.py output:
        {name, value, value_numeric, proponent, province, cma, naics_2digit,
         status, description, source_url, source_title, discovery_source, confidence}
    """
    if not GEMINI_API_KEY:
        print("  [COMPOUND] No GEMINI_API_KEY — skipping.")
        return []

    enabled = os.environ.get('GEMINI_SEARCH_ENABLED', 'false').lower() == 'true'
    if not enabled:
        print("  [COMPOUND] Disabled (set GEMINI_SEARCH_ENABLED=true in .env)")
        return []

    start = time.time()

    # Run async discovery
    try:
        loop = asyncio.get_event_loop()
        if loop.is_running():
            # Inside an already-running event loop (e.g. Jupyter)
            import nest_asyncio
            nest_asyncio.apply()
            raw_projects = loop.run_until_complete(run_compound_discovery())
        else:
            raw_projects = asyncio.run(run_compound_discovery())
    except RuntimeError:
        raw_projects = asyncio.run(run_compound_discovery())

    elapsed = time.time() - start
    print(f"  [COMPOUND] Async phase: {elapsed:.1f}s")

    # Normalize to pipeline-compatible format
    normalized = []
    for rp in raw_projects:
        name = (rp.get("name") or "").strip()
        if not name or len(name) < 3:
            continue

        loc = rp.get("location", {}) if isinstance(rp.get("location"), dict) else {}
        province = loc.get("province") or rp.get("_source_query_province", "")
        cma = loc.get("cma") or loc.get("city") or ""

        source_url = (rp.get("source_url") or "").strip()
        source_name = (rp.get("source_name") or "").strip()

        normalized.append({
            "name": name,
            "value": _format_value(rp.get("value_millions")),
            "value_numeric": rp.get("value_millions"),
            "proponent": (rp.get("proponent") or "Unknown").strip(),
            "province": province,
            "cma": cma,
            "naics_2digit": (rp.get("naics_2digit") or "").strip(),
            "status": _normalize_status(rp.get("status", "")),
            "description": (rp.get("description") or "").strip(),
            "source_url": source_url,
            "source_title": source_name,
            "discovery_source": "gemini_compound",
            "confidence": "verified" if rp.get("_grounded") else "unverified",
            "project_type": rp.get("project_type", ""),
            "_section": f"{rp.get('_source_query_sector', '')}_{rp.get('_source_query_geo_tier', '')}",
            # Pass through evidence array from grounding extraction
            "_evidence": rp.get("_evidence", []),
        })

    # Deduplicate within results (by name + province)
    seen = set()
    unique = []
    for p in normalized:
        key = (p["name"].lower().strip(), p.get("province", "").lower().strip())
        if key not in seen:
            seen.add(key)
            unique.append(p)

    print(f"  [COMPOUND] {len(unique)} unique projects "
          f"(from {len(raw_projects)} raw mentions, {len(raw_projects)-len(unique)} dupes)")

    return unique
