"""
gemini_pro_reasoning.py — Gemini Pro reasoning layer.

Calls Gemini 2.5 Pro WITHOUT Google Search grounding. Pro receives
context from Flash's search results and applies higher-order reasoning.

Cost: $1.25/M input + $10/M output tokens. No grounding fee.
Estimated annual usage: ~1.5M input + ~0.5M output = ~$7 tokens/year.
"""

import asyncio
import aiohttp
import json
import re
import os
import logging
from datetime import datetime

logger = logging.getLogger(__name__)

GEMINI_API_KEY = os.environ.get("GEMINI_API_KEY", "")
GEMINI_PRO_MODEL = "gemini-2.5-pro"
GEMINI_PRO_ENDPOINT = (
    f"https://generativelanguage.googleapis.com/v1beta/models/"
    f"{GEMINI_PRO_MODEL}:generateContent"
)
PRO_TIMEOUT = 180


async def call_pro(system_prompt, user_prompt, temperature=0.2):
    """Call Gemini Pro WITHOUT grounding. Pure reasoning on provided context.

    Returns:
        str: Pro's response text, or None on failure
    """
    payload = {
        "contents": [{"parts": [{"text": user_prompt}]}],
        # NOTE: No "tools" key — no Google Search grounding
        "generationConfig": {
            "temperature": temperature,
            "maxOutputTokens": 4096,
        },
        "systemInstruction": {
            "parts": [{"text": system_prompt}]
        },
    }

    url = f"{GEMINI_PRO_ENDPOINT}?key={GEMINI_API_KEY}"

    try:
        async with aiohttp.ClientSession() as session:
            async with session.post(
                url, json=payload,
                timeout=aiohttp.ClientTimeout(total=PRO_TIMEOUT)
            ) as resp:
                if resp.status == 200:
                    data = await resp.json()
                    candidates = data.get("candidates", [])
                    if candidates:
                        parts = candidates[0].get("content", {}).get("parts", [])
                        return " ".join(p.get("text", "") for p in parts).strip()
                    return None
                else:
                    text = await resp.text()
                    logger.warning(f"Pro API error {resp.status}: {text[:300]}")
                    return None
    except asyncio.TimeoutError:
        logger.warning("Pro API timeout")
        return None
    except Exception as e:
        logger.warning(f"Pro API exception: {e}")
        return None


def call_pro_sync(system_prompt, user_prompt, temperature=0.2):
    """Synchronous wrapper for call_pro.

    Handles running/not-running event loops, same pattern as gemini_engine.
    """
    try:
        loop = asyncio.get_event_loop()
        if loop.is_running():
            import nest_asyncio
            nest_asyncio.apply()
            return loop.run_until_complete(
                call_pro(system_prompt, user_prompt, temperature)
            )
        else:
            return asyncio.run(
                call_pro(system_prompt, user_prompt, temperature)
            )
    except RuntimeError:
        return asyncio.run(
            call_pro(system_prompt, user_prompt, temperature)
        )


def parse_pro_json(response):
    """Parse JSON from Pro's response, stripping markdown fences."""
    if not response:
        return None

    cleaned = re.sub(r'```json\s*', '', response)
    cleaned = re.sub(r'```\s*', '', cleaned).strip()

    # Try direct parse
    try:
        return json.loads(cleaned)
    except json.JSONDecodeError:
        pass

    # Find JSON object
    obj_start = cleaned.find('{')
    if obj_start >= 0:
        depth = 0
        for i in range(obj_start, len(cleaned)):
            if cleaned[i] == '{':
                depth += 1
            elif cleaned[i] == '}':
                depth -= 1
                if depth == 0:
                    try:
                        return json.loads(cleaned[obj_start:i + 1])
                    except json.JSONDecodeError:
                        pass
                    break
    return None


def store_follow_up_queries(db, queries):
    """Store Pro-generated follow-up queries for next week's Flash run."""
    if not queries:
        return
    try:
        db.collection("pipeline_state").document("follow_up_queries").set({
            "queries": queries,
            "generated": datetime.utcnow().isoformat(),
            "status": "pending",
            "count": len(queries),
        })
        logger.info(f"Stored {len(queries)} follow-up queries for next week")
    except Exception as e:
        logger.warning(f"Failed to store follow-up queries: {e}")


def get_follow_up_queries(db):
    """Retrieve stored follow-up queries at the start of each week's run."""
    try:
        doc = db.collection("pipeline_state").document("follow_up_queries").get()
        if doc.exists:
            data = doc.to_dict()
            if data.get("status") == "pending":
                db.collection("pipeline_state").document("follow_up_queries").update({
                    "status": "consumed",
                    "consumed_at": datetime.utcnow().isoformat(),
                })
                return data.get("queries", [])
    except Exception as e:
        logger.warning(f"Failed to read follow-up queries: {e}")
    return []
